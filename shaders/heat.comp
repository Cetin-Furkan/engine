#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_GOOGLE_include_directive : require

// One invocation updates one vertex. The 888 fillet vertices use the baked
// neighbor table. A face sample uses the grid neighbors on that face, so
// the table does not grow. A face corner also exchanges heat with the two
// samples beside it. Positions stay in the bake. dt_ms is the callback
// interval. A seed write fills the upper half. A poke raises temperatures
// near one click. Nothing here reads the framebuffer.

#include "face_grid.inc"

layout(local_size_x = 64) in;

// Per second. A 16 ms callback moves 0.048 of the way toward the neighbors.
const float k_rate = 3.0;

layout(buffer_reference, scalar, buffer_reference_align = 4) buffer Field {
    float t[];
};

layout(buffer_reference, scalar, buffer_reference_align = 4) buffer Mesh {
    float f[];
};

layout(push_constant, scalar) uniform Push {
    uint64_t src;
    uint64_t dst;
    uint64_t verts;
    uint dt_ms;
    uint seed;
    uint poke;
    float poke_x;
    float poke_y;
    float yaw_deg;
} pc;

#include "heat_nbr.inc"

// Same pose as cube.vert. The face is 16 cells across about 216 px, so a
// click is within one cell of a sample. The spot is fully hot inside 16 px
// and fades by 48 px.
const float k_edge_px = 240.0;
const float k_spot_inner = 16.0;
const float k_spot_outer = 48.0;

bool upper_half(uint id) {
    return (k_hot_bits[id >> 5u] & (1u << (id & 31u))) != 0u;
}

bool seeded(uint id) {
    if (id < k_fillet_verts) {
        return upper_half(id);
    }
    uint face;
    uint i;
    uint j;
    grid_decode(id, face, i, j);
    return face_point(face, i, j).y > 0.0;
}

vec3 rest_pos(uint id) {
    Mesh mesh = Mesh(pc.verts);
    uint o = id * 9u;
    return vec3(mesh.f[o], mesh.f[o + 1u], mesh.f[o + 2u]);
}

vec2 placed(vec3 in_pos, float yaw_deg) {
    const float ax = radians(28.0);
    float ay = radians(yaw_deg);
    mat3 rx = mat3(vec3(1.0, 0.0, 0.0),
                   vec3(0.0, cos(ax), sin(ax)),
                   vec3(0.0, -sin(ax), cos(ax)));
    mat3 ry = mat3(vec3(cos(ay), 0.0, -sin(ay)),
                   vec3(0.0, 1.0, 0.0),
                   vec3(sin(ay), 0.0, cos(ay)));
    vec3 p = ((ry * rx) * in_pos) * (k_edge_px * 0.5);
    return p.xy;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= k_grid_verts) {
        return;
    }
    Field out_field = Field(pc.dst);
    if (pc.seed != 0u) {
        out_field.t[id] = seeded(id) ? 1.0 : 0.0;
        return;
    }
    Field in_field = Field(pc.src);
    float cur = in_field.t[id];
    float sum = 0.0;
    uint n = 0u;
    if (id < k_fillet_verts) {
        uint begin = k_off[id];
        uint end = k_off[id + 1u];
        n = end - begin;
        for (uint s = begin; s < end; ++s) {
            sum += in_field.t[k_nbr[s]];
        }
        uint face;
        uint gi;
        uint gj;
        if (face_corner_at(rest_pos(id), face, gi, gj)) {
            uint ni = gi == 0u ? 1u : k_grid - 1u;
            uint nj = gj == 0u ? 1u : k_grid - 1u;
            sum += in_field.t[grid_vertex(face, ni, gj)];
            sum += in_field.t[grid_vertex(face, gi, nj)];
            n += 2u;
        }
    } else {
        uint face;
        uint i;
        uint j;
        grid_decode(id, face, i, j);
        if (i > 0u) {
            sum += in_field.t[grid_vertex(face, i - 1u, j)];
            n += 1u;
        }
        if (i < k_grid) {
            sum += in_field.t[grid_vertex(face, i + 1u, j)];
            n += 1u;
        }
        if (j > 0u) {
            sum += in_field.t[grid_vertex(face, i, j - 1u)];
            n += 1u;
        }
        if (j < k_grid) {
            sum += in_field.t[grid_vertex(face, i, j + 1u)];
            n += 1u;
        }
    }
    float next = cur;
    if (n > 0u) {
        float avg = sum / float(n);
        float blend = clamp(float(pc.dt_ms) * (k_rate / 1000.0), 0.0, 1.0);
        next = (1.0 - blend) * cur + blend * avg;
    }
    if (pc.poke != 0u) {
        vec2 p = placed(rest_pos(id), pc.yaw_deg);
        float d = distance(p, vec2(pc.poke_x, pc.poke_y));
        float spot = 1.0 - smoothstep(k_spot_inner, k_spot_outer, d);
        next = max(next, spot);
    }
    out_field.t[id] = next;
}
