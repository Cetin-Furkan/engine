# ==============================================================================
# Git Ignore - C23 Engine
# ==============================================================================

# Build artifacts & dependencies
build/
.dependencies/

# Compiled outputs
*.o
*.d
*.a
*.so
*.dylib
*.spv

# Editor & IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Engine-written placement. opening.world stays the boot document.
examples/demo/world/live.world
examples/demo/world/live.world.tmp
examples/demo/world/sheet.live
examples/demo/world/sheet.live.tmp

# Auto-synthesized compressed terrain cache (.epack v1) & local benchmark runs
examples/demo/maps/*.epack
examples/demo/maps/*.epack.tmp
benchmarks/
__pycache__/

# Logs & debugging
*.log
vgcore.*
/core
/core.*
compile_commands.json

# Documentation temporary files
doc/*.tmp

# Workspace text dumps, local screenshots & extraction scripts
wayplot_part_*.txt
ALL_WAYPLOT_CODE.txt
for_*_codes.md
for_grok_to_read.md
images/
copy.py
